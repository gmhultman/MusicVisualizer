<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK target gives access to media sessions (song-change detection). Runs on 1809+. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyTitle>Music Visualizer</AssemblyTitle>
    <RootNamespace>MusicVisualizer</RootNamespace>
    <!-- Embedded in the .exe: used by Explorer and pinned taskbar shortcuts. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program.Main replaces WPF's generated Main so Velopack runs before anything else. -->
    <StartupObject>MusicVisualizer.Program</StartupObject>
    <!-- Local builds show this; release builds pass -p:Version=X.Y.Z from the git tag. -->
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; avoid ambiguous type names with WPF. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <!-- Also available as a WPF resource for the window and tray icons. -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MusicVisualizer.Tests" />
  </ItemGroup>

</Project>
