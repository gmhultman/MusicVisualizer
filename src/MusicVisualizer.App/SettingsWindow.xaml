<Window x:Class="MusicVisualizer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Music Visualizer Settings"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="520" Height="760" MinHeight="300"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#101018" Foreground="#E6E6F0"
        FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#0C0C12" BorderBrush="#26263A" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" IsCancel="True" Click="OnCloseClick" />
                <TextBlock Text="Changes apply immediately." Foreground="{StaticResource Dlg.SubText}" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,0,20,20">

                <!-- 1. Visualizers -->
                <TextBlock Text="Visualizers" Style="{StaticResource SectionHeader}" />
                <UniformGrid x:Name="VisualizerList" Columns="2" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="Unticked visualizers are hidden from the toolbar, tray menu, number keys and cycling." />

                <!-- 2. Auto-cycle -->
                <TextBlock Text="Auto-cycle" Style="{StaticResource SectionHeader}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Change visualizer" VerticalAlignment="Center" />
                    <ComboBox x:Name="CycleVisualizersBox" Grid.Column="1" Margin="0,3" SelectionChanged="OnCycleVisualizersChanged">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="Every few minutes" />
                        <ComboBoxItem Content="Each new song" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Text="Change colors" VerticalAlignment="Center" />
                    <ComboBox x:Name="CycleColorsBox" Grid.Row="1" Grid.Column="1" Margin="0,3" SelectionChanged="OnCycleColorsChanged">
                        <ComboBoxItem Content="Off" />
                        <ComboBoxItem Content="With each visualizer change" />
                        <ComboBoxItem Content="Every few minutes" />
                        <ComboBoxItem Content="Each new song" />
                    </ComboBox>

                    <TextBlock x:Name="MinutesLabel" Grid.Row="2" Text="Every" VerticalAlignment="Center" />
                    <StackPanel x:Name="MinutesPanel" Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3">
                        <TextBox x:Name="MinutesBox" Width="70" HorizontalContentAlignment="Right"
                                 LostKeyboardFocus="OnMinutesLostFocus" KeyDown="OnMinutesKeyDown" />
                        <TextBlock x:Name="MinutesHint" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <CheckBox x:Name="ShuffleBox" Margin="0,8,0,3" Content="Shuffle (random order, no repeats until all have played)"
                          Click="OnShuffleClick" />
                <TextBlock Style="{StaticResource Caption}"
                           Text="New songs are detected from apps that show what's playing in Windows (Spotify, browsers, Media Player…); otherwise a short silence between tracks counts." />

                <!-- 3. Colors -->
                <TextBlock Text="Colors" Style="{StaticResource SectionHeader}" />
                <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                           Text="Ticked palettes are included when stepping or cycling through colors." />
                <Border Background="#181822" CornerRadius="6" Padding="6">
                    <StackPanel x:Name="PaletteList" />
                </Border>
                <Button Content="New palette…" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnNewPaletteClick" />

                <!-- 4. Display -->
                <TextBlock Text="Display" Style="{StaticResource SectionHeader}" />
                <CheckBox x:Name="GlowBox" Content="Glow" Click="OnGlowClick" />
                <CheckBox x:Name="FadeBox" Content="Smooth fade between visualizers" Click="OnFadeClick" />
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="50" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Overlay opacity" VerticalAlignment="Center" />
                    <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" SmallChange="5" LargeChange="10"
                            IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                            ValueChanged="OnOpacityChanged" />
                    <TextBlock x:Name="OpacityText" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Text="Applies to overlay mode only." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
