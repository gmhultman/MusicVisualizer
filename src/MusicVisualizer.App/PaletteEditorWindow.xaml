<Window x:Class="MusicVisualizer.PaletteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New palette"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#101018" Foreground="#E6E6F0"
        FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkControls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A colour swatch button: the Background is the colour. -->
            <Style x:Key="SwatchButton" TargetType="Button">
                <Setter Property="Width" Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="Margin" Value="0,0,8,0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="#40FFFFFF" BorderThickness="2" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#C0FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#00B8E6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="Name" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" TextChanged="OnNameChanged" MaxLength="40" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Dlg.Error}" FontSize="12" Margin="0,4,0,0"
                   TextWrapping="Wrap" Visibility="Collapsed" />

        <TextBlock Text="Colors" Margin="0,14,0,4" />
        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8" Text="Click a color to change it." />
        <StackPanel Orientation="Horizontal">
            <StackPanel x:Name="SwatchPanel" Orientation="Horizontal" />
            <StackPanel VerticalAlignment="Center">
                <Button x:Name="AddButton" Content="+" Width="28" Padding="0,0,0,2" Margin="0,0,0,4" Click="OnAddClick" ToolTip="Add a color" />
                <Button x:Name="RemoveButton" Content="−" Width="28" Padding="0,0,0,2" Click="OnRemoveClick" ToolTip="Remove the last color" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="Preview" Margin="0,14,0,4" />
        <Border x:Name="Preview" Height="28" CornerRadius="6" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SaveButton" Content="Save" MinWidth="80" IsDefault="True" Style="{StaticResource AccentButton}" Click="OnSaveClick" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
