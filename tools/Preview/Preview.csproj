<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: renders visualizers offscreen with a synthetic track and saves PNGs and timings. Usage: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MusicVisualizer.App\MusicVisualizer.App.csproj" />
  </ItemGroup>
</Project>
